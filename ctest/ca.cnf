[ ca ]
default_ca = CA_default
[ CA_default ]
dir = /home/yashi/c/MQTTDeviceTestingTool/ctest
database = $dir/index.txt
new_certs_dir = $dir/newcerts
certificate = $dir/ca.crt
private_key = $dir/k.key
serial = $dir/serial
default_md = sha256
policy = policy_any
email_in_dn = no
unique_subject = no
copy_extensions = none
default_days = 365
[ policy_any ]
commonName = supplied
countryName = optional
organizationName = optional
organizationalUnitName = optional
